    /* ============================================================
       Utilities
    ============================================================ */
    function uid() {
      return Math.random().toString(36).slice(2, 10);
    }

    function formatBytes(bytes) {
      if (!bytes) return '0 B';
      const units = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1) + ' ' + units[i];
    }

    function showError(message) {
      errorMessage.textContent = message;
      errorDialog.showModal();
    }

    function debouncePreview(delay = 260) {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(() => renderPreview(), delay);
    }

    function triggerDownload(url, filename) {
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
    }

    /* ============================================================
       Arial font loading (CDN)
    ============================================================ */
    const fontReady = (async () => {
      try {
        const font = new FontFace(
          'ArialCDN',
          'url(https://cdn.jsdelivr.net/npm/@canvas-fonts/arial@1.0.4/Arial.ttf)',
          { weight: '400', style: 'normal' }
        );
        await font.load();
        document.fonts.add(font);
        await document.fonts.ready;
      } catch (err) {
        console.warn('Arial CDN font not available; using system Arial.', err);
      }
    })();

    /* ============================================================
       PDF.js worker
    ============================================================ */
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      pdfjsReady = true;
    }

    /* ============================================================
       Page range parsing
    ============================================================ */
    function parsePageRange(str, total) {
      const s = (str || '').trim().toLowerCase();
      if (!s || s === 'all') return Array.from({ length: total }, (_, i) => i);

      const pages = new Set();

      if (s === 'odd') {
        for (let i = 0; i < total; i += 2) pages.add(i);
        return Array.from(pages).sort((a, b) => a - b);
      }
      if (s === 'even') {
        for (let i = 1; i < total; i += 2) pages.add(i);
        return Array.from(pages).sort((a, b) => a - b);
      }

      for (const part of s.split(',')) {
        const trimmed = part.trim();
        if (!trimmed) continue;

        const rangeMatch = trimmed.match(/^(\d+)\s*-\s*(\d+)$/);
        if (rangeMatch) {
          const a = Math.max(1, parseInt(rangeMatch[1], 10));
          const b = Math.min(total, parseInt(rangeMatch[2], 10));
          for (let i = a; i <= b; i++) pages.add(i - 1);
        } else {
          const n = parseInt(trimmed, 10);
          if (n >= 1 && n <= total) pages.add(n - 1);
        }
      }

      // Fall back to all pages if nothing valid was parsed
      if (!pages.size) return Array.from({ length: total }, (_, i) => i);
      return Array.from(pages).sort((a, b) => a - b);
    }

    /* ============================================================
       File handling
    ============================================================ */
    function addFiles(fileList) {
      const pdfs = Array.from(fileList).filter(
        (f) => f.type === 'application/pdf' || /\.pdf$/i.test(f.name)
      );

      if (!pdfs.length) {
        showError('Please select PDF files.');
        return;
      }

      for (const file of pdfs) {
        state.files.push({
          id: uid(),
          file,
          name: file.name,
          size: file.size,
          status: 'ready',
          resultBlob: null,
          resultUrl: null,
          pdfjsDoc: null,
          error: null
        });
      }

      if (!state.selectedId) {
        state.selectedId = state.files[0].id;
        state.previewPage = 0;
      }

      renderFileList();
      updateBatchSummary();
      renderPreview();
    }

    function getSelectedFile() {
      return state.files.find((f) => f.id === state.selectedId) || null;
    }

    function removeFile(id) {
      const idx = state.files.findIndex((f) => f.id === id);
      if (idx === -1) return;

      const [removed] = state.files.splice(idx, 1);
      if (removed.resultUrl) URL.revokeObjectURL(removed.resultUrl);

      if (state.selectedId === id) {
        state.selectedId = state.files[0]?.id || null;
        state.previewPage = 0;
      }

      renderFileList();
      updateBatchSummary();
      renderPreview();
    }

    function selectFile(id) {
      state.selectedId = id;
      state.previewPage = 0;
      renderFileList();
      renderPreview();
    }

    /* ============================================================
       File list rendering
    ============================================================ */
    function statusLabel(status) {
      const map = {
        ready: 'Ready',
        processing: 'Processing',
        done: 'Done',
        error: 'Error'
      };
      return map[status] || status;
    }

    function statusClass(status) {
      return 'status-' + status;
    }

    function renderFileList() {
      if (!state.files.length) {
        fileListEl.innerHTML = '<div class="empty-list">No PDFs added yet.</div>';
        return;
      }

      fileListEl.innerHTML = state.files
        .map((f) => {
          const selected = f.id === state.selectedId ? ' selected' : '';
          const downloadBtn =
            f.status === 'done' && f.resultUrl
              ? `<button class="circle transparent" data-action="download" data-id="${f.id}" title="Download">
                   <i>download</i>
                 </button>`
              : '';

          return `
            <div class="file-row${selected}" data-id="${f.id}">
              <i class="file-icon">picture_as_pdf</i>
              <div class="file-info max">
                <div class="file-name" title="${f.name}">${f.name}</div>
                <div class="file-meta">${formatBytes(f.size)}</div>
              </div>
              <span class="chip small status-chip ${statusClass(f.status)}">${statusLabel(f.status)}</span>
              ${downloadBtn}
              <button class="circle transparent" data-action="remove" data-id="${f.id}" title="Remove">
                <i>close</i>
              </button>
            </div>
          `;
        })
        .join('');

      // Row click = select
      fileListEl.querySelectorAll('.file-row').forEach((row) => {
        row.addEventListener('click', (e) => {
          if (e.target.closest('button')) return;
          selectFile(row.dataset.id);
        });
      });

      // Action buttons
      fileListEl.querySelectorAll('button[data-action]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const { action, id } = btn.dataset;
          if (action === 'remove') removeFile(id);
          if (action === 'download') {
            const f = state.files.find((x) => x.id === id);
            if (f?.resultUrl) {
              triggerDownload(f.resultUrl, f.name.replace(/\.pdf$/i, '') + '-watermarked.pdf');
            }
          }
        });
      });
    }

    function updateBatchSummary() {
      const total = state.files.length;
      const done = state.files.filter((f) => f.status === 'done').length;
      const errors = state.files.filter((f) => f.status === 'error').length;

      batchStatus.textContent = total
        ? `${done} of ${total} processed${errors ? ` · ${errors} error${errors > 1 ? 's' : ''}` : ''}`
        : '';

      downloadAllBtn.disabled = done === 0 || processing;
      processBtn.disabled = total === 0 || processing;

      if (total && done === total) {
        batchStatus.textContent = `All ${total} file${total > 1 ? 's' : ''} processed`;
      }
    }

    /* ============================================================
       Watermark canvas generation
    ============================================================ */
    function getFontString(settings, fontSizePx) {
      const weight = (settings.fontStyle === 'bold' || settings.fontStyle === 'bold-italic') ? 'bold' : 'normal';
      const style = (settings.fontStyle === 'italic' || settings.fontStyle === 'bold-italic') ? 'italic' : 'normal';
      return `${style} ${weight} ${fontSizePx}px ArialCDN, Arial, Helvetica, sans-serif`;
    }

    function drawOneText(ctx, text, x, y, settings, fontSizePx, scale) {
      const metrics = ctx.measureText(text);
      const textW = metrics.width;
      const textH = fontSizePx * 1.2;

      // Background box
      if (settings.bgBox) {
        const pad = settings.bgBoxPadding * scale;
        ctx.save();
        ctx.globalAlpha = settings.opacity * (settings.bgBoxOpacity / 100);
        ctx.fillStyle = settings.bgBoxColor;
        ctx.fillRect(x - textW / 2 - pad, y - textH / 2 - pad, textW + pad * 2, textH + pad * 2);
        ctx.restore();
      }

      // Outline
      if (settings.outline) {
        ctx.save();
        ctx.globalAlpha = settings.opacity;
        ctx.lineWidth = settings.outlineWidth * scale;
        ctx.strokeStyle = settings.outlineColor;
        ctx.lineJoin = 'round';
        ctx.strokeText(text, x, y);
        ctx.restore();
      }

      // Fill
      ctx.save();
      ctx.globalAlpha = settings.opacity;
      ctx.fillStyle = settings.color;
      ctx.fillText(text, x, y);
      ctx.restore();
    }

    function drawTextPattern(ctx, w, h, settings, scale) {
      const fontSizePx = Math.max(6, settings.fontSize * scale);
      ctx.font = getFontString(settings, fontSizePx);
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      // Letter spacing (modern browsers)
      if (settings.letterSpacing && 'letterSpacing' in ctx) {
        ctx.letterSpacing = settings.letterSpacing + 'px';
      }

      const text = settings.text.trim() || 'CONFIDENTIAL';

      ctx.save();
      ctx.translate(w / 2, h / 2);
      ctx.rotate((settings.angle * Math.PI) / 180);

      if (!settings.mosaic) {
        drawOneText(ctx, text, 0, 0, settings, fontSizePx, scale);
      } else {
        const textWidth = ctx.measureText(text).width;
        const gapFactor =
          settings.coverage === 50 ? 2.6 :
          settings.coverage === 75 ? 1.2 : 0.35;

        const outlineExtra = settings.outline ? settings.outlineWidth * scale * 2 : 0;
        const gapX = textWidth + outlineExtra + fontSizePx * gapFactor;
        const gapY = fontSizePx * (1 + gapFactor) + outlineExtra;

        const diagonal = Math.hypot(w, h) * 1.4;

        for (let y = -diagonal; y <= diagonal; y += gapY) {
          for (let x = -diagonal; x <= diagonal; x += gapX) {
            drawOneText(ctx, text, x, y, settings, fontSizePx, scale);
          }
        }
      }

      ctx.restore();

      if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
    }

    function drawImagePattern(ctx, w, h, settings, scale) {
      const img = settings.image;
      if (!img) return;

      const coverage = settings.coverage / 100;
      const imgW = w * coverage;
      const imgH = imgW * (img.naturalHeight / img.naturalWidth);

      const gapFactor =
        settings.coverage === 50 ? 0.8 :
        settings.coverage === 75 ? 0.4 : 0.12;

      const gapX = imgW * gapFactor;
      const gapY = imgH * gapFactor;

      ctx.save();
      ctx.globalAlpha = settings.opacity;
      ctx.translate(w / 2, h / 2);
      ctx.rotate((settings.angle * Math.PI) / 180);

      if (settings.flipH) ctx.scale(-1, 1);
      if (settings.flipV) ctx.scale(1, -1);

      if (!settings.mosaic) {
        ctx.drawImage(img, -imgW / 2, -imgH / 2, imgW, imgH);
      } else {
        const diagonal = Math.hypot(w, h) * 1.4;
        for (let y = -diagonal; y <= diagonal; y += imgH + gapY) {
          for (let x = -diagonal; x <= diagonal; x += imgW + gapX) {
            ctx.drawImage(img, x - imgW / 2, y - imgH / 2, imgW, imgH);
          }
        }
      }
      ctx.restore();
    }

    async function generateWatermarkCanvas(width, height, scale, options = {}) {
      await fontReady;

      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(width));
      canvas.height = Math.max(1, Math.round(height));

      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (options.skip) return canvas;

      const s = state.settings;

      // Image first (text overlays on top)
      if ((s.type === 'image' || s.type === 'both') && s.image) {
        drawImagePattern(ctx, canvas.width, canvas.height, s, scale);
      }

      // Text
      if (s.type === 'text' || s.type === 'both') {
        drawTextPattern(ctx, canvas.width, canvas.height, s, scale);
      }

      return canvas;
    }

    /* ============================================================
       Preview
    ============================================================ */
    function updatePreviewNav() {
      const entry = getSelectedFile();
      const total = entry?.pdfjsDoc?.numPages || 0;

      if (total === 0) {
        pageIndicator.textContent = '— / —';
        prevPageBtn.disabled = true;
        nextPageBtn.disabled = true;
        return;
      }

      const current = state.previewPage + 1;
      const pageIndices = parsePageRange(state.settings.pageRange, total);
      const skipped = !pageIndices.includes(state.previewPage);

      pageIndicator.textContent = `${current} / ${total}`;
      pageIndicator.style.color = skipped ? 'var(--error)' : 'var(--on-surface-variant)';
      pageIndicator.title = skipped ? 'This page will be skipped' : 'This page will be watermarked';

      prevPageBtn.disabled = state.previewPage <= 0;
      nextPageBtn.disabled = state.previewPage >= total - 1;
    }

    async function renderPreview() {
      const entry = getSelectedFile();

      if (!entry) {
        previewCanvas.style.display = 'none';
        previewEmpty.hidden = false;
        previewEmpty.innerHTML =
          '<i>picture_as_pdf</i><p>Upload a PDF and select it to preview the watermark.</p>';
        previewMeta.textContent = '';
        updatePreviewNav();
        return;
      }

      if (!pdfjsReady) {
        previewEmpty.innerHTML =
          '<i>error</i><p>PDF.js failed to load. Please refresh the page.</p>';
        previewEmpty.hidden = false;
        previewCanvas.style.display = 'none';
        return;
      }

      previewEmpty.innerHTML =
        '<i>hourglass_top</i><p>Rendering preview…</p>';
      previewEmpty.hidden = false;
      previewCanvas.style.display = 'none';

      try {
        if (!entry.pdfjsDoc) {
          const bytes = await entry.file.arrayBuffer();
          entry.pdfjsDoc = await pdfjsLib.getDocument({ data: bytes }).promise;
        }

        const totalPages = entry.pdfjsDoc.numPages;
        if (state.previewPage >= totalPages) state.previewPage = totalPages - 1;
        if (state.previewPage < 0) state.previewPage = 0;

        const page = await entry.pdfjsDoc.getPage(state.previewPage + 1);
        const baseViewport = page.getViewport({ scale: 1 });

        const targetWidth = 680;
        const scale = Math.min(2, targetWidth / baseViewport.width);
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const renderViewport = page.getViewport({ scale: scale * dpr });

        const canvas = previewCanvas;
        canvas.width = Math.floor(renderViewport.width);
        canvas.height = Math.floor(renderViewport.height);
        canvas.style.width = Math.floor(renderViewport.width / dpr) + 'px';
        canvas.style.height = Math.floor(renderViewport.height / dpr) + 'px';

        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        await page.render({
          canvasContext: ctx,
          viewport: renderViewport
        }).promise;

        // Check if this page should be watermarked
        const pageIndices = parsePageRange(state.settings.pageRange, totalPages);
        const skip = !pageIndices.includes(state.previewPage);

        const wmScale = canvas.width / baseViewport.width;
        const wmCanvas = await generateWatermarkCanvas(
          canvas.width,
          canvas.height,
          wmScale,
          { skip }
        );

        ctx.drawImage(wmCanvas, 0, 0);

        previewCanvas.style.display = 'block';
        previewEmpty.hidden = true;

        previewMeta.textContent =
          `${Math.round(baseViewport.width)} × ${Math.round(baseViewport.height)} pt`;

        updatePreviewNav();
      } catch (err) {
        console.error(err);
        previewEmpty.innerHTML =
          '<i>error</i><p>Could not render this PDF. It may be encrypted or malformed.</p>';
        previewEmpty.hidden = false;
        previewCanvas.style.display = 'none';
        updatePreviewNav();
      }
    }

    /* ============================================================
       Processing
    ============================================================ */
    function canvasToPngBytes(canvas) {
      return new Promise((resolve, reject) => {
        canvas.toBlob(async (blob) => {
          if (!blob) {
            reject(new Error('Could not export watermark canvas.'));
            return;
          }
          resolve(new Uint8Array(await blob.arrayBuffer()));
        }, 'image/png');
      });
    }

    async function processAll() {
      if (processing) return;

      const pending = state.files.filter((f) => f.status !== 'done');
      if (!pending.length) {
        showError('All files have already been processed.');
        return;
      }

      processing = true;
      processBtn.disabled = true;
      downloadAllBtn.disabled = true;
      batchProgress.hidden = false;
      batchProgress.value = 0;

      const total = pending.length;

      for (let i = 0; i < pending.length; i++) {
        const entry = pending[i];
        entry.status = 'processing';
        entry.error = null;
        renderFileList();
        updateBatchSummary();

        batchStatus.textContent = `Processing ${i + 1} of ${total} — ${entry.name}`;

        try {
          const bytes = await entry.file.arrayBuffer();
          const pdfDoc = await PDFLib.PDFDocument.load(bytes, {
            ignoreEncryption: true,
            updateMetadata: false
          });

          const pages = pdfDoc.getPages();
          const totalPages = pages.length;
          const pageIndices = new Set(parsePageRange(state.settings.pageRange, totalPages));

          for (let pIdx = 0; pIdx < totalPages; pIdx++) {
            if (!pageIndices.has(pIdx)) continue;

            const page = pages[pIdx];
            const { width, height } = page.getSize();

            const outputScale = Math.min(2, 3000 / Math.max(width, height));
            const wmCanvas = await generateWatermarkCanvas(
              width * outputScale,
              height * outputScale,
              outputScale
            );

            const pngBytes = await canvasToPngBytes(wmCanvas);
            const pngImage = await pdfDoc.embedPng(pngBytes);

            page.drawImage(pngImage, {
              x: 0,
              y: 0,
              width,
              height
            });
          }

          const outBytes = await pdfDoc.save();
          const blob = new Blob([outBytes], { type: 'application/pdf' });

          if (entry.resultUrl) URL.revokeObjectURL(entry.resultUrl);
          entry.resultBlob = blob;
          entry.resultUrl = URL.createObjectURL(blob);
          entry.status = 'done';
        } catch (err) {
          console.error('Processing failed for', entry.name, err);
          entry.status = 'error';
          entry.error = err.message || 'Unknown error';
        }

        renderFileList();
        updateBatchSummary();
        batchProgress.value = Math.round(((i + 1) / total) * 100);
      }

      processing = false;
      processBtn.disabled = false;
      updateBatchSummary();

      const errors = state.files.filter((f) => f.status === 'error').length;
      const done = state.files.filter((f) => f.status === 'done').length;

      batchStatus.textContent =
        `Done — ${done} processed${errors ? `, ${errors} failed` : ''}`;

      setTimeout(() => {
        batchProgress.hidden = true;
      }, 1200);

      renderPreview();
    }

    async function downloadAll() {
      const done = state.files.filter((f) => f.status === 'done' && f.resultBlob);
      if (!done.length) return;

      if (done.length === 1) {
        triggerDownload(
          done[0].resultUrl,
          done[0].name.replace(/\.pdf$/i, '') + '-watermarked.pdf'
        );
        return;
      }

      const zip = new JSZip();

      done.forEach((f) => {
        const name = f.name.replace(/\.pdf$/i, '') + '-watermarked.pdf';
        zip.file(name, f.resultBlob);
      });

      try {
        const blob = await zip.generateAsync({ type: 'blob' });
        const url = URL.createObjectURL(blob);
        triggerDownload(url, 'watermarked-pdfs.zip');
        setTimeout(() => URL.revokeObjectURL(url), 10000);
      } catch (err) {
        console.error(err);
        showError('Could not create the ZIP file.');
      }
    }

    /* ============================================================
       Settings UI sync
    ============================================================ */
    function updateTypeUI() {
      const type = state.settings.type;

      textSettings.hidden = type === 'image';
      imageSettings.hidden = type === 'text';

      typeToggle.querySelectorAll('button').forEach((btn) => {
        const active = btn.dataset.type === type;
        btn.classList.toggle('fill', active);
        btn.classList.toggle('primary', active);
      });
    }

    function updateCoverageUI() {
      coverageToggle.querySelectorAll('button').forEach((btn) => {
        const active = Number(btn.dataset.coverage) === state.settings.coverage;
        btn.classList.toggle('fill', active);
        btn.classList.toggle('primary', active);
      });
    }

    function updateFontStyleUI() {
      fontStyleToggle.querySelectorAll('button').forEach((btn) => {
        const active = btn.dataset.style === state.settings.fontStyle;
        btn.classList.toggle('fill', active);
        btn.classList.toggle('primary', active);
      });
    }

    function updateMosaicUI() {
      mosaicToggle.checked = state.settings.mosaic;
      mosaicNote.hidden = state.settings.mosaic;
    }

    function updateTextSettingsUI() {
      textInput.value = state.settings.text;
      fontSize.value = state.settings.fontSize;
      fontSizeValue.textContent = state.settings.fontSize + ' pt';
      textColor.value = state.settings.color;
      colorHex.textContent = state.settings.color;
      opacity.value = Math.round(state.settings.opacity * 100);
      opacityValue.textContent = Math.round(state.settings.opacity * 100) + '%';
      angle.value = state.settings.angle;
      angleValue.textContent = state.settings.angle + '°';
      letterSpacing.value = state.settings.letterSpacing;
      letterSpacingValue.textContent = state.settings.letterSpacing + 'px';

      outlineToggle.checked = state.settings.outline;
      outlineOptions.hidden = !state.settings.outline;
      outlineWidth.value = state.settings.outlineWidth;
      outlineWidthValue.textContent = state.settings.outlineWidth;
      outlineColor.value = state.settings.outlineColor;

      bgBoxToggle.checked = state.settings.bgBox;
      bgBoxOptions.hidden = !state.settings.bgBox;
      bgBoxPadding.value = state.settings.bgBoxPadding;
      bgBoxPaddingValue.textContent = state.settings.bgBoxPadding;
      bgBoxOpacity.value = state.settings.bgBoxOpacity;
      bgBoxOpacityValue.textContent = state.settings.bgBoxOpacity + '%';
      bgBoxColor.value = state.settings.bgBoxColor;

      pageRange.value = state.settings.pageRange;
      flipHToggle.checked = state.settings.flipH;
      flipVToggle.checked = state.settings.flipV;
    }

    function updateAllUI() {
      updateTypeUI();
      updateCoverageUI();
      updateFontStyleUI();
      updateMosaicUI();
      updateTextSettingsUI();
    }

    /* ============================================================
       Presets (localStorage)
    ============================================================ */
    function getPresets() {
      try {
        return JSON.parse(localStorage.getItem(PRESET_KEY)) || {};
      } catch {
        return {};
      }
    }

    function savePresets(presets) {
      try {
        localStorage.setItem(PRESET_KEY, JSON.stringify(presets));
        return true;
      } catch (err) {
        console.warn('Could not save presets:', err);
        return false;
      }
    }

    function refreshPresetSelect() {
      const presets = getPresets();
      const current = presetSelect.value;
      presetSelect.innerHTML = '<option value="">— Load preset —</option>';

      for (const name of Object.keys(presets)) {
        const opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        presetSelect.appendChild(opt);
      }

      if (presets[current]) presetSelect.value = current;
    }

    function saveCurrentPreset() {
      const name = prompt('Preset name:');
      if (!name || !name.trim()) return;

      const presets = getPresets();
      const settings = { ...state.settings };
      delete settings.image; // image objects cannot be serialized

      presets[name.trim()] = settings;

      if (savePresets(presets)) {
        refreshPresetSelect();
        presetSelect.value = name.trim();
      } else {
        showError('Could not save preset. Storage may be full.');
      }
    }

    function applyPreset(name) {
      const presets = getPresets();
      const p = presets[name];
      if (!p) return;

      // Keep current image (presets don't store image data)
      const currentImage = state.settings.image;
      state.settings = { ...DEFAULT_SETTINGS, ...p, image: currentImage };

      updateAllUI();
      debouncePreview();
    }

    function resetSettings() {
      const currentImage = state.settings.image;
      state.settings = { ...DEFAULT_SETTINGS, image: currentImage };
      updateAllUI();
      debouncePreview();
    }

    /* ============================================================
       Event listeners
    ============================================================ */

    // Upload / dropzone
    dropzone.addEventListener('click', () => pdfInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        pdfInput.click();
      }
    });

    pdfInput.addEventListener('change', (e) => {
      if (e.target.files?.length) addFiles(e.target.files);
      pdfInput.value = '';
    });

    ['dragenter', 'dragover'].forEach((evt) => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach((evt) => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dragover');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      if (e.dataTransfer?.files?.length) addFiles(e.dataTransfer.files);
    });

    // Type toggle
    typeToggle.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-type]');
      if (!btn) return;
      state.settings.type = btn.dataset.type;
      updateTypeUI();
      debouncePreview();
    });

    // Coverage toggle
    coverageToggle.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-coverage]');
      if (!btn) return;
      state.settings.coverage = Number(btn.dataset.coverage);
      updateCoverageUI();
      debouncePreview();
    });

    // Font style toggle
    fontStyleToggle.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-style]');
      if (!btn) return;
      state.settings.fontStyle = btn.dataset.style;
      updateFontStyleUI();
      debouncePreview();
    });

    // Text input
    textInput.addEventListener('input', () => {
      state.settings.text = textInput.value;
      debouncePreview();
    });

    // Font size
    fontSize.addEventListener('input', () => {
      state.settings.fontSize = Number(fontSize.value);
      fontSizeValue.textContent = fontSize.value + ' pt';
      debouncePreview();
    });

    // Letter spacing
    letterSpacing.addEventListener('input', () => {
      state.settings.letterSpacing = Number(letterSpacing.value);
      letterSpacingValue.textContent = letterSpacing.value + 'px';
      debouncePreview();
    });

    // Color
    textColor.addEventListener('input', () => {
      state.settings.color = textColor.value;
      colorHex.textContent = textColor.value;
      debouncePreview();
    });

    // Opacity
    opacity.addEventListener('input', () => {
      state.settings.opacity = Number(opacity.value) / 100;
      opacityValue.textContent = opacity.value + '%';
      debouncePreview();
    });

    // Angle
    angle.addEventListener('input', () => {
      state.settings.angle = Number(angle.value);
      angleValue.textContent = angle.value + '°';
      debouncePreview();
    });

    // Outline
    outlineToggle.addEventListener('change', () => {
      state.settings.outline = outlineToggle.checked;
      outlineOptions.hidden = !outlineToggle.checked;
      debouncePreview();
    });

    outlineWidth.addEventListener('input', () => {
      state.settings.outlineWidth = Number(outlineWidth.value);
      outlineWidthValue.textContent = outlineWidth.value;
      debouncePreview();
    });

    outlineColor.addEventListener('input', () => {
      state.settings.outlineColor = outlineColor.value;
      debouncePreview();
    });

    // Background box
    bgBoxToggle.addEventListener('change', () => {
      state.settings.bgBox = bgBoxToggle.checked;
      bgBoxOptions.hidden = !bgBoxToggle.checked;
      debouncePreview();
    });

    bgBoxPadding.addEventListener('input', () => {
      state.settings.bgBoxPadding = Number(bgBoxPadding.value);
      bgBoxPaddingValue.textContent = bgBoxPadding.value;
      debouncePreview();
    });

    bgBoxOpacity.addEventListener('input', () => {
      state.settings.bgBoxOpacity = Number(bgBoxOpacity.value);
      bgBoxOpacityValue.textContent = bgBoxOpacity.value + '%';
      debouncePreview();
    });

    bgBoxColor.addEventListener('input', () => {
      state.settings.bgBoxColor = bgBoxColor.value;
      debouncePreview();
    });

    // Mosaic toggle
    mosaicToggle.addEventListener('change', () => {
      state.settings.mosaic = mosaicToggle.checked;
      updateMosaicUI();
      debouncePreview();
    });

    // Page range
    pageRange.addEventListener('input', () => {
      state.settings.pageRange = pageRange.value || 'all';
      debouncePreview();
    });

    // Flip toggles
    flipHToggle.addEventListener('change', () => {
      state.settings.flipH = flipHToggle.checked;
      debouncePreview();
    });

    flipVToggle.addEventListener('change', () => {
      state.settings.flipV = flipVToggle.checked;
      debouncePreview();
    });

    // Image upload
    imageUploadBtn.addEventListener('click', () => imageInput.click());

    imageInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const img = new Image();
      const url = URL.createObjectURL(file);

      img.onload = () => {
        URL.revokeObjectURL(url);
        state.settings.image = img;
        imagePreview.src = img.src;
        imagePreviewRow.hidden = false;
        imageName.textContent = file.name;

        if (state.settings.type === 'text') {
          state.settings.type = 'image';
          updateTypeUI();
        }
        debouncePreview();
      };

      img.onerror = () => {
        URL.revokeObjectURL(url);
        showError('Could not load that image. Please choose a PNG or JPEG.');
      };

      img.src = url;
      imageInput.value = '';
    });

    removeImageBtn.addEventListener('click', () => {
      state.settings.image = null;
      imagePreviewRow.hidden = true;
      imagePreview.removeAttribute('src');
      imageName.textContent = '';
      if (state.settings.type === 'image') {
        state.settings.type = 'text';
        updateTypeUI();
      }
      debouncePreview();
    });

    // Preview page navigation
    prevPageBtn.addEventListener('click', () => {
      if (state.previewPage > 0) {
        state.previewPage--;
        renderPreview();
      }
    });

    nextPageBtn.addEventListener('click', () => {
      const entry = getSelectedFile();
      const total = entry?.pdfjsDoc?.numPages || 0;
      if (state.previewPage < total - 1) {
        state.previewPage++;
        renderPreview();
      }
    });

    // Preview / process
    previewBtn.addEventListener('click', () => renderPreview());
    processBtn.addEventListener('click', processAll);
    downloadAllBtn.addEventListener('click', downloadAll);

    // Clear all
    clearAllBtn.addEventListener('click', () => {
      if (!state.files.length) return;
      if (!confirm('Remove all files from the queue?')) return;
      state.files.forEach((f) => { if (f.resultUrl) URL.revokeObjectURL(f.resultUrl); });
      state.files = [];
      state.selectedId = null;
      state.previewPage = 0;
      renderFileList();
      updateBatchSummary();
      renderPreview();
    });

    // Presets
    savePresetBtn.addEventListener('click', saveCurrentPreset);

    presetSelect.addEventListener('change', () => {
      if (presetSelect.value) applyPreset(presetSelect.value);
    });

    resetPresetBtn.addEventListener('click', () => {
      if (confirm('Reset all watermark settings to defaults?')) resetSettings();
    });

    // Theme toggle
    $('#themeToggle').addEventListener('click', () => {
      const isDark = document.body.classList.toggle('dark');
      document.body.classList.toggle('light', !isDark);
      $('#themeToggle i').textContent = isDark ? 'light_mode' : 'dark_mode';
    });

    // Help
    $('#helpBtn').addEventListener('click', () => helpDialog.showModal());

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      const modifier = e.ctrlKey || e.metaKey;

      // Ctrl/Cmd + O — open files
      if (modifier && e.key.toLowerCase() === 'o') {
        e.preventDefault();
        pdfInput.click();
      }

      // Ctrl/Cmd + Enter — process all
      if (modifier && e.key === 'Enter') {
        e.preventDefault();
        processAll();
      }

      // Ctrl/Cmd + S — save preset
      if (modifier && e.key.toLowerCase() === 's') {
        e.preventDefault();
        saveCurrentPreset();
      }

      // ? — show help
      if (e.key === '?' && !modifier) {
        const tag = document.activeElement?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
        helpDialog.showModal();
      }
    });

    /* ============================================================
       Init
    ============================================================ */
    (function init() {
      // Respect system dark mode preference
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (prefersDark) {
        document.body.classList.remove('light');
        document.body.classList.add('dark');
        $('#themeToggle i').textContent = 'light_mode';
      } else {
        document.body.classList.add('light');
      }

      updateAllUI();
      refreshPresetSelect();
      renderFileList();
      updateBatchSummary();
    })();

  </script>
</body>
</html>
