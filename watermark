<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PDF Watermark Studio — Client-Side</title>

  <!-- Beer CSS (Material Design 3) -->
  <link href="https://cdn.jsdelivr.net/npm/beercss@4.0.21/dist/cdn/beer.min.css" rel="stylesheet" />
  <script type="module" src="https://cdn.jsdelivr.net/npm/beercss@4.0.21/dist/cdn/beer.min.js"></script>

  <!-- Material Symbols (icons) -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

  <!-- Arial via CDN (UI + canvas fallback) -->
  <link href="https://fonts.cdnfonts.com/css/arial-2" rel="stylesheet" />

  <!-- PDF.js (preview rendering) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <!-- pdf-lib (PDF modification) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>

  <!-- JSZip (batch download) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <style>
    :root {
      --font: Arial, Helvetica, sans-serif;
      --font-icon: "Material Symbols Outlined";
    }

    body {
      background: var(--background);
      min-height: 100vh;
      transition: background .2s ease, color .2s ease;
    }

    main {
      padding-top: 5.5rem;
      padding-bottom: 3rem;
    }

    .app-title {
      display: flex;
      align-items: center;
      gap: .5rem;
      font-weight: 600;
      letter-spacing: -.01em;
    }

    .app-title i {
      color: var(--primary);
    }

    .privacy-chip {
      color: var(--primary);
      background: var(--primary-container);
      border: 1px solid var(--primary-border);
      white-space: nowrap;
    }

    article {
      padding: 1.25rem;
    }

    article h6 {
      display: flex;
      align-items: center;
      gap: .4rem;
      margin-bottom: 1rem;
      color: var(--on-surface);
      font-weight: 600;
    }

    article h6 i {
      font-size: 1.25rem;
      color: var(--primary);
    }

    .dropzone {
      border: 2px dashed var(--outline);
      border-radius: 1rem;
      padding: 1.75rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: border-color .18s ease, background .18s ease;
      background: var(--surface);
    }

    .dropzone:hover,
    .dropzone.dragover {
      border-color: var(--primary);
      background: var(--primary-container);
    }

    .dropzone i {
      font-size: 2.5rem;
      color: var(--primary);
      margin-bottom: .35rem;
    }

    .dropzone p {
      margin: .15rem 0;
      color: var(--on-surface-variant);
    }

    .small-text {
      color: var(--on-surface-variant);
      font-size: .8rem;
    }

    .segmented {
      display: flex;
      gap: .35rem;
      flex-wrap: wrap;
    }

    .segmented button {
      flex: 1 1 auto;
      min-width: 0;
      font-size: .8rem;
      padding: 0 .75rem;
      height: 2.5rem;
    }

    .slider-row {
      display: flex;
      align-items: center;
      gap: .75rem;
      width: 100%;
      margin-bottom: .5rem;
    }

    .slider-row input[type="range"] {
      flex: 1;
      accent-color: var(--primary);
      height: 2rem;
      background: transparent;
    }

    .slider-value {
      min-width: 3.5rem;
      text-align: right;
      font-variant-numeric: tabular-nums;
      color: var(--on-surface-variant);
      font-size: .85rem;
    }

    .color-row {
      display: flex;
      align-items: center;
      gap: .75rem;
      margin-bottom: .75rem;
    }

    input[type="color"] {
      width: 3rem;
      height: 2.5rem;
      padding: 0;
      border: 1px solid var(--outline);
      border-radius: .5rem;
      background: none;
      cursor: pointer;
    }

    .color-hex {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: .8rem;
      color: var(--on-surface-variant);
    }

    .preview-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 280px;
      max-height: 560px;
      overflow: auto;
      border-radius: .75rem;
      background: var(--surface-variant);
      border: 1px solid var(--outline-variant);
      padding: .75rem;
    }

    #previewCanvas {
      display: none;
      max-width: 100%;
      height: auto;
      border-radius: .25rem;
      box-shadow: var(--elevate2);
      background: #fff;
    }

    .preview-empty {
      text-align: center;
      color: var(--on-surface-variant);
      padding: 2rem 1rem;
    }

    .preview-empty i {
      font-size: 2.5rem;
      opacity: .5;
      margin-bottom: .5rem;
    }

    .file-list {
      display: flex;
      flex-direction: column;
    }

    .file-row {
      display: flex;
      align-items: center;
      gap: .65rem;
      padding: .65rem .25rem;
      border-bottom: 1px solid var(--outline-variant);
      cursor: pointer;
      border-radius: .5rem;
      transition: background .15s ease;
    }

    .file-row:last-child {
      border-bottom: none;
    }

    .file-row:hover {
      background: var(--surface-variant);
    }

    .file-row.selected {
      background: var(--primary-container);
    }

    .file-icon {
      color: var(--primary);
      flex: none;
    }

    .file-info {
      min-width: 0;
    }

    .file-name {
      font-size: .85rem;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .file-meta {
      font-size: .7rem;
      color: var(--on-surface-variant);
    }

    .status-chip {
      flex: none;
      font-size: .65rem;
      height: 1.6rem;
      padding: 0 .55rem;
      pointer-events: none;
    }

    .status-ready {
      background: var(--surface-variant);
      color: var(--on-surface-variant);
    }

    .status-processing {
      background: var(--secondary-container);
      color: var(--on-secondary-container);
    }

    .status-done {
      background: var(--primary-container);
      color: var(--primary);
    }

    .status-error {
      background: var(--error-container);
      color: var(--error);
    }

    .empty-list {
      padding: 1.25rem .25rem;
      color: var(--on-surface-variant);
      text-align: center;
      font-size: .85rem;
    }

    .batch-actions {
      display: flex;
      align-items: center;
      gap: .5rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    progress {
      margin-top: .75rem;
    }

    .image-preview-row {
      display: flex;
      align-items: center;
      gap: .75rem;
      margin: .75rem 0;
    }

    .image-thumb {
      width: 3.5rem;
      height: 3.5rem;
      object-fit: contain;
      border-radius: .5rem;
      border: 1px solid var(--outline-variant);
      background: var(--surface-variant);
    }

    /* Collapsible sections */
    details > summary {
      cursor: pointer;
      padding: .35rem 0;
      font-size: .85rem;
      color: var(--on-surface-variant);
      list-style: none;
      display: flex;
      align-items: center;
      gap: .35rem;
      user-select: none;
      font-weight: 500;
    }

    details > summary::-webkit-details-marker {
      display: none;
    }

    details > summary::before {
      content: 'chevron_right';
      font-family: 'Material Symbols Outlined';
      font-size: 1.1rem;
      transition: transform .15s ease;
    }

    details[open] > summary::before {
      transform: rotate(90deg);
    }

    details > summary i {
      font-size: 1.1rem;
      color: var(--primary);
    }

    kbd {
      display: inline-block;
      padding: .15rem .4rem;
      border: 1px solid var(--outline);
      border-radius: .25rem;
      background: var(--surface-variant);
      font-size: .75rem;
      font-family: ui-monospace, monospace;
    }

    dialog {
      max-width: 440px;
    }

    .preset-select {
      width: 100%;
      padding: .6rem .75rem;
      border: 1px solid var(--outline);
      border-radius: .5rem;
      background: var(--surface);
      color: var(--on-surface);
      font-size: .85rem;
      cursor: pointer;
    }

    .preset-select:focus {
      outline: 2px solid var(--primary);
      outline-offset: -1px;
    }

    @media (max-width: 600px) {
      article {
        padding: 1rem;
      }

      .preview-wrap {
        min-height: 220px;
      }

      .segmented button {
        font-size: .72rem;
        padding: 0 .5rem;
      }
    }
  </style>
</head>

<body class="light">

  <!-- Top app bar -->
  <header class="fixed">
    <nav>
      <button class="transparent circle" id="themeToggle" title="Toggle dark mode">
        <i>dark_mode</i>
      </button>
      <div class="app-title max">
        <i>water_drop</i>
        <span>PDF Watermark Studio</span>
      </div>
      <button class="transparent circle" id="helpBtn" title="Keyboard shortcuts">
        <i>keyboard</i>
      </button>
      <span class="chip small privacy-chip" title="Files never leave your browser">
        <i>shield</i>
        <span>Client-side only</span>
      </span>
    </nav>
  </header>

  <main class="responsive">

    <div class="grid">

      <!-- LEFT: Inputs and settings -->
      <div class="s12 m5 l4">

        <!-- Upload PDFs -->
        <article class="border no-elevate" style="margin-bottom: 1rem;">
          <h6><i>upload_file</i> PDF files</h6>

          <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Upload PDF files">
            <i>cloud_upload</i>
            <p><strong>Drop PDFs here</strong></p>
            <p class="small-text">or click to browse — multiple files supported</p>
          </div>

          <input type="file" id="pdfInput" accept="application/pdf" multiple hidden />

          <p class="small-text" style="margin-top: .75rem;">
            Files are processed in your browser and never uploaded.
          </p>
        </article>

        <!-- Watermark settings -->
        <article class="border no-elevate">
          <h6><i>tune</i> Watermark settings</h6>

          <!-- Type -->
          <label class="small-text" style="display:block; margin-bottom:.4rem;">Type</label>
          <nav class="group segmented" id="typeToggle" style="margin-bottom: 1rem;">
            <button class="left-round fill primary" data-type="text">Text</button>
            <button class="no-round" data-type="image">Image</button>
            <button class="right-round" data-type="both">Both</button>
          </nav>

          <!-- TEXT SETTINGS -->
          <div id="textSettings">
            <div class="field label border" style="margin-bottom: .75rem;">
              <input id="textInput" type="text" placeholder=" " value="CONFIDENTIAL" maxlength="80" />
              <label>Watermark text</label>
            </div>

            <div class="slider-row">
              <label for="fontSize" class="small-text" style="min-width: 3.5rem;">Size</label>
              <input id="fontSize" type="range" min="8" max="200" value="48" step="1" />
              <output id="fontSizeValue" class="slider-value">48 pt</output>
            </div>

            <label class="small-text" style="display:block; margin-bottom:.4rem;">Font style</label>
            <nav class="group segmented" id="fontStyleToggle" style="margin-bottom: 1rem;">
              <button class="left-round fill primary" data-style="normal">N</button>
              <button class="no-round" data-style="bold"><b>B</b></button>
              <button class="no-round" data-style="italic"><i>I</i></button>
              <button class="right-round" data-style="bold-italic"><b><i>BI</i></b></button>
            </nav>

            <div class="slider-row">
              <label for="letterSpacing" class="small-text" style="min-width: 4.5rem;">Spacing</label>
              <input id="letterSpacing" type="range" min="0" max="50" value="0" step="1" />
              <output id="letterSpacingValue" class="slider-value">0px</output>
            </div>

            <div class="color-row">
              <label class="small-text max">Text color</label>
              <input id="textColor" type="color" value="#e53935" />
              <span id="colorHex" class="color-hex">#e53935</span>
            </div>

            <!-- Text effects (collapsible) -->
            <details id="textEffects" style="margin-top: .5rem;">
              <summary><i>auto_awesome</i> Text effects</summary>

              <label class="checkbox" style="margin-top:.5rem;">
                <input type="checkbox" id="outlineToggle" />
                <span>Outline</span>
              </label>
              <div id="outlineOptions" hidden style="padding-left: .25rem;">
                <div class="slider-row">
                  <label class="small-text" style="min-width: 3.5rem;">Width</label>
                  <input id="outlineWidth" type="range" min="1" max="10" value="2" step="1" />
                  <output id="outlineWidthValue" class="slider-value">2</output>
                </div>
                <div class="color-row">
                  <label class="small-text max">Outline color</label>
                  <input id="outlineColor" type="color" value="#ffffff" />
                </div>
              </div>

              <label class="checkbox">
                <input type="checkbox" id="bgBoxToggle" />
                <span>Background box</span>
              </label>
              <div id="bgBoxOptions" hidden style="padding-left: .25rem;">
                <div class="slider-row">
                  <label class="small-text" style="min-width: 3.5rem;">Padding</label>
                  <input id="bgBoxPadding" type="range" min="2" max="30" value="8" step="1" />
                  <output id="bgBoxPaddingValue" class="slider-value">8</output>
                </div>
                <div class="slider-row">
                  <label class="small-text" style="min-width: 3.5rem;">Opacity</label>
                  <input id="bgBoxOpacity" type="range" min="5" max="100" value="20" step="1" />
                  <output id="bgBoxOpacityValue" class="slider-value">20%</output>
                </div>
                <div class="color-row">
                  <label class="small-text max">Box color</label>
                  <input id="bgBoxColor" type="color" value="#ffffff" />
                </div>
              </div>
            </details>
          </div>

          <!-- IMAGE SETTINGS -->
          <div id="imageSettings" hidden>
            <button class="border responsive" id="imageUploadBtn" style="margin-bottom: .5rem;">
              <i>add_photo_alternate</i>
              <span>Choose watermark image</span>
            </button>
            <input type="file" id="imageInput" accept="image/png,image/jpeg" hidden />

            <div id="imagePreviewRow" class="image-preview-row" hidden>
              <img id="imagePreview" class="image-thumb" alt="Watermark image" />
              <div class="max">
                <div id="imageName" class="file-name" style="font-size:.8rem;"></div>
                <div class="file-meta">PNG or JPEG</div>
              </div>
              <button id="removeImageBtn" class="circle transparent" title="Remove image">
                <i>close</i>
              </button>
            </div>

            <details style="margin-top: .5rem;">
              <summary><i>flip</i> Image options</summary>
              <label class="checkbox" style="margin-top:.5rem;">
                <input type="checkbox" id="flipHToggle" />
                <span>Flip horizontal</span>
              </label>
              <label class="checkbox">
                <input type="checkbox" id="flipVToggle" />
                <span>Flip vertical</span>
              </label>
            </details>
          </div>

          <div class="divider" style="margin: 1rem 0;"></div>

          <!-- Mosaic toggle -->
          <label class="checkbox">
            <input type="checkbox" id="mosaicToggle" checked />
            <span>Mosaic (tiled) pattern</span>
          </label>
          <div id="mosaicNote" class="small-text" style="margin: .25rem 0 .5rem;" hidden>
            Single centered watermark. Coverage controls image size only.
          </div>

          <!-- Page range -->
          <div class="field label border" style="margin-top: .5rem;">
            <input id="pageRange" type="text" placeholder=" " value="all" />
            <label>Pages: all, odd, even, 1-3,5</label>
          </div>

          <div class="divider" style="margin: 1rem 0;"></div>

          <!-- Coverage -->
          <label class="small-text" style="display:block; margin-bottom:.4rem;">Page coverage</label>
          <nav class="group segmented" id="coverageToggle" style="margin-bottom: 1rem;">
            <button class="left-round" data-coverage="50">50%</button>
            <button class="no-round" data-coverage="75">75%</button>
            <button class="right-round" data-coverage="100">100%</button>
          </nav>

          <!-- Opacity -->
          <div class="slider-row">
            <label for="opacity" class="small-text" style="min-width: 4.5rem;">Opacity</label>
            <input id="opacity" type="range" min="5" max="95" value="35" step="1" />
            <output id="opacityValue" class="slider-value">35%</output>
          </div>

          <!-- Angle -->
          <div class="slider-row">
            <label for="angle" class="small-text" style="min-width: 4.5rem;">Angle</label>
            <input id="angle" type="range" min="-90" max="90" value="-30" step="1" />
            <output id="angleValue" class="slider-value">-30°</output>
          </div>
        </article>

        <!-- Presets -->
        <article class="border no-elevate" style="margin-top: 1rem;">
          <h6><i>bookmark</i> Presets</h6>
          <select id="presetSelect" class="preset-select" aria-label="Load preset">
            <option value="">— Load preset —</option>
          </select>
          <div class="row" style="margin-top: .75rem; gap: .35rem;">
            <button id="savePresetBtn" class="border small">
              <i>save</i> Save
            </button>
            <button id="resetPresetBtn" class="border small">
              <i>restart_alt</i> Reset
            </button>
          </div>
        </article>
      </div>

      <!-- RIGHT: Preview and batch -->
      <div class="s12 m7 l8">

        <!-- Preview -->
        <article class="border no-elevate" style="margin-bottom: 1rem;">
          <h6><i>visibility</i> Preview</h6>

          <div class="preview-wrap">
            <div class="preview-empty" id="previewEmpty">
              <i>picture_as_pdf</i>
              <p>Upload a PDF and select it to preview the watermark.</p>
            </div>
            <canvas id="previewCanvas"></canvas>
          </div>

          <div class="row" style="margin-top: .75rem; align-items: center; gap: .35rem;">
            <button id="prevPageBtn" class="border circle small" disabled title="Previous page">
              <i>chevron_left</i>
            </button>
            <span id="pageIndicator" class="small-text" style="color: var(--on-surface-variant); min-width: 5rem; text-align: center;">— / —</span>
            <button id="nextPageBtn" class="border circle small" disabled title="Next page">
              <i>chevron_right</i>
            </button>
            <div class="max"></div>
            <span id="previewMeta" class="small-text" style="color: var(--on-surface-variant);"></span>
            <button id="previewBtn" class="border small" title="Refresh preview">
              <i>refresh</i>
            </button>
          </div>
        </article>

        <!-- Batch -->
        <article class="border no-elevate">
          <div class="row" style="margin-bottom: 1rem; align-items: center;">
            <h6 style="margin: 0;"><i>folder</i> Batch queue</h6>
            <div class="max"></div>
            <button id="clearAllBtn" class="transparent circle small" title="Clear all files">
              <i>delete_sweep</i>
            </button>
          </div>

          <div id="fileList" class="file-list">
            <div class="empty-list">No PDFs added yet.</div>
          </div>

          <div class="batch-actions">
            <button id="processBtn" class="fill primary">
              <i>play_arrow</i>
              <span>Process all</span>
            </button>
            <button id="downloadAllBtn" class="border" disabled>
              <i>download</i>
              <span>Download all (.zip)</span>
            </button>
            <div class="max"></div>
            <span id="batchStatus" class="small-text"></span>
          </div>

          <progress id="batchProgress" value="0" max="100" hidden></progress>
        </article>

      </div>
    </div>
  </main>

  <!-- Error dialog -->
  <dialog id="errorDialog">
    <h5>Something went wrong</h5>
    <p id="errorMessage"></p>
    <nav class="right-align">
      <button class="border" onclick="document.getElementById('errorDialog').close()">Close</button>
    </nav>
  </dialog>

  <!-- Help dialog -->
  <dialog id="helpDialog">
    <h5>Keyboard shortcuts</h5>
    <div class="row" style="margin: .5rem 0;">
      <span class="max">Open files</span>
      <kbd>Ctrl</kbd><span style="margin:0 .15rem;">+</span><kbd>O</kbd>
    </div>
    <div class="row" style="margin: .5rem 0;">
      <span class="max">Process all</span>
      <kbd>Ctrl</kbd><span style="margin:0 .15rem;">+</span><kbd>Enter</kbd>
    </div>
    <div class="row" style="margin: .5rem 0;">
      <span class="max">Save preset</span>
      <kbd>Ctrl</kbd><span style="margin:0 .15rem;">+</span><kbd>S</kbd>
    </div>
    <div class="row" style="margin: .5rem 0;">
      <span class="max">Show this help</span>
      <kbd>?</kbd>
    </div>
    <div class="row" style="margin: .5rem 0;">
      <span class="max">Close dialog</span>
      <kbd>Esc</kbd>
    </div>
    <nav class="right-align" style="margin-top: 1rem;">
      <button class="border" onclick="document.getElementById('helpDialog').close()">Close</button>
    </nav>
  </dialog>

  <script>
    /* ============================================================
       Constants & state
    ============================================================ */
    const PRESET_KEY = 'pdfWatermarkPresets_v2';

    const DEFAULT_SETTINGS = {
      type: 'text',
      text: 'CONFIDENTIAL',
      fontSize: 48,
      color: '#e53935',
      opacity: 0.35,
      coverage: 75,
      angle: -30,
      image: null,
      mosaic: true,
      pageRange: 'all',
      fontStyle: 'normal',
      letterSpacing: 0,
      outline: false,
      outlineWidth: 2,
      outlineColor: '#ffffff',
      bgBox: false,
      bgBoxPadding: 8,
      bgBoxOpacity: 20,
      bgBoxColor: '#ffffff',
      flipH: false,
      flipV: false
    };

    const state = {
      files: [],
      selectedId: null,
      previewPage: 0,
      settings: { ...DEFAULT_SETTINGS }
    };

    let pdfjsReady = false;
    let previewTimer = null;
    let processing = false;

    /* ============================================================
       DOM refs
    ============================================================ */
    const $ = (sel) => document.querySelector(sel);

    const dropzone = $('#dropzone');
    const pdfInput = $('#pdfInput');
    const fileListEl = $('#fileList');
    const previewCanvas = $('#previewCanvas');
    const previewEmpty = $('#previewEmpty');
    const previewMeta = $('#previewMeta');
    const previewBtn = $('#previewBtn');
    const processBtn = $('#processBtn');
    const downloadAllBtn = $('#downloadAllBtn');
    const batchStatus = $('#batchStatus');
    const batchProgress = $('#batchProgress');
    const clearAllBtn = $('#clearAllBtn');

    const textSettings = $('#textSettings');
    const imageSettings = $('#imageSettings');
    const textInput = $('#textInput');
    const fontSize = $('#fontSize');
    const fontSizeValue = $('#fontSizeValue');
    const textColor = $('#textColor');
    const colorHex = $('#colorHex');
    const opacity = $('#opacity');
    const opacityValue = $('#opacityValue');
    const angle = $('#angle');
    const angleValue = $('#angleValue');
    const imageInput = $('#imageInput');
    const imageUploadBtn = $('#imageUploadBtn');
    const imagePreviewRow = $('#imagePreviewRow');
    const imagePreview = $('#imagePreview');
    const imageName = $('#imageName');
